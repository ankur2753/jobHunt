# Automated Job Search Agent Environment Configuration Example
# Copy this file to .env and fill in your configuration values:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# LLM / OpenRouter Configuration
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here

# -----------------------------------------------------------------------------
# Remote Application Logging Configuration
# -----------------------------------------------------------------------------
# Primary Option: Google Sheets Webhook URL (Recommended)
# Deploy Google Apps Script Web App (see scripts/common_stuff/google_apps_script.js)
# and paste your Web App deployment URL below:
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
# Alternative alias:
# REMOTE_LOGGER_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Secondary Option: Firebase Firestore Remote Logging (Optional fallback)
# Option A: Custom HTTP Webhook / Cloud Function endpoint for Firebase
# FIREBASE_WEBHOOK_URL=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/logApplication
# Option B: Direct Firestore REST API (pushes documents to 'job_applications' collection)
# FIREBASE_PROJECT_ID=your_firebase_project_id
